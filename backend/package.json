{
  "name": "ams-backend",
  "version": "1.0.0",
  "description": "Asset Management System Backend Services",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:property": "jest --testPathPattern=property",
    "test:integration": "jest --testPathPattern=integration",
    "schema:smoke": "node scripts/schema-smoke-check.js",
    "contract:procurement:openapi": "node scripts/procurement-openapi-parity-check.js",
    "contract:procurement:model": "node scripts/procurement-model-contract-check.js",
    "contract:asset:model": "node scripts/asset-model-contract-check.js",
    "contract:admin:model": "node scripts/admin-model-contract-check.js",
    "contract:ham:model": "node scripts/ham-model-contract-check.js",
    "contract:lifecycle:model": "node scripts/lifecycle-model-contract-check.js",
    "contract:eam:model": "node scripts/eam-model-contract-check.js",
    "contract:sam:model": "node scripts/sam-model-contract-check.js",
    "contract:integration:model": "node scripts/integration-model-contract-check.js",
    "contract:notification:model": "node scripts/notification-model-contract-check.js",
    "contract:report:model": "node scripts/report-model-contract-check.js",
    "contract:all:model": "npm run contract:asset:model && npm run contract:procurement:model && npm run contract:admin:model && npm run contract:lifecycle:model && npm run contract:ham:model && npm run contract:eam:model && npm run contract:sam:model && npm run contract:integration:model && npm run contract:notification:model && npm run contract:report:model",
    "contract:routes:runtime": "node scripts/route-runtime-parity-check.js",
    "smoke:integration": "ts-node --project scripts/tsconfig.json scripts/integration-smoke.ts",
    "smoke:integration:dataapi": "ts-node --project scripts/tsconfig.json scripts/integration-smoke-data-api.ts",
    "smoke:api:write": "ts-node --project scripts/tsconfig.json scripts/api-write-smoke.ts",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'packages/**/*.ts'",
    "lint:fix": "eslint 'packages/**/*.ts' --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'packages/**/*.ts'",
    "format:check": "prettier --check 'packages/**/*.ts'",
    "db:migrate": "ts-node scripts/migrate.ts",
    "db:seed": "ts-node scripts/seed.ts",
    "audit:seed": "ts-node --project scripts/tsconfig.json scripts/audit-seed.ts",
    "audit:cleanup": "ts-node --project scripts/tsconfig.json scripts/audit-cleanup.ts",
    "audit:db:wiring": "ts-node --project scripts/tsconfig.json scripts/audit-db-wireup.ts",
    "db:verify": "ts-node scripts/verify-deployment.ts",
    "db:backfill:hardware-location-ownership": "ts-node scripts/backfill-hardware-location-ownership.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.478.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@aws-sdk/credential-provider-node": "^3.972.5",
    "@opensearch-project/opensearch": "^2.13.0",
    "@types/aws-lambda": "^8.10.131",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "esbuild": "^0.19.11",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
