  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ams/types": "1.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3"
  }
}
