{
  "name": "@ams/api-integration",
  "version": "1.0.0",
  "description": "Integration tests for AMS services",
  "main": "index.js",
  "scripts": {
    "build": "echo 'No build required for integration tests'",
    "test": "jest --config=jest.config.js",
