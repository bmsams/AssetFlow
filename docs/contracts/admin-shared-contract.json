      "methods": [
        "GET",
        "POST"
      ]
    },
    {
      "path": "/admin/users",
      "methods": [
        "GET"
      ]
    }
  ],
  "requiredOpenApiRoutes": [
    {
      "path": "/admin/buildings",
      "methods": [
        "GET",
