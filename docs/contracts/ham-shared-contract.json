{
  "contractVersion": "2026-03-07",
  "module": "ham",
  "scope": "Hardware asset movement and stockroom operations across transfer, loaner, disposal, and audit workflows.",
  "sharedEntities": [
    "assets",
    "stockrooms",
    "buildings",
    "users"
  ],
  "enums": {
    "transferOrderStatus": [
      "DRAFT",
      "PENDING_APPROVAL",
      "APPROVED",
      "REJECTED",
      "IN_TRANSIT",
      "PARTIALLY_RECEIVED",
      "RECEIVED",
      "COMPLETED",
      "CANCELLED",
      "ON_HOLD"
    ],
    "transferPriority": [
      "LOW",
      "NORMAL",
      "HIGH",
      "URGENT",
      "CRITICAL"
    ],
    "transferLineStatus": [
      "PENDING",
      "SHIPPED",
      "IN_TRANSIT",
      "RECEIVED",
      "PARTIALLY_RECEIVED",
      "DAMAGED",
      "CANCELLED"
    ]
  },
  "entities": {
    "transferOrders": {
      "table": "transfer_orders",
      "requiredColumns": [
        "transfer_id",
        "transfer_number",
        "from_stockroom_id",
        "to_stockroom_id",
        "status",
        "priority",
        "total_line_count",
        "total_quantity"
      ]
    },
    "transferOrderLines": {
      "table": "transfer_order_lines",
      "requiredColumns": [
        "line_id",
        "transfer_id",
        "line_number",
        "quantity",
        "status"
      ]
    },
    "stockroomInventory": {
      "table": "stockroom_inventory",
      "requiredColumns": [
        "inventory_id",
        "stockroom_id",
        "product_id",
        "product_type",
        "quantity_on_hand",
        "quantity_reserved"
      ]
    },
    "loanerCheckouts": {
      "table": "loaner_checkouts",
      "requiredColumns": [
        "checkout_id",
        "asset_id",
        "checked_out_to",
        "checkout_date",
        "due_date",
        "status"
      ]
    },
    "disposalWorkflows": {
      "table": "disposal_workflows",
      "requiredColumns": [
        "workflow_id",
        "asset_id",
        "status",
        "disposal_method",
        "initiated_by"
      ]
    },
    "auditRecords": {
      "table": "audit_records",
      "requiredColumns": [
        "audit_id",
        "stockroom_id",
        "audit_type",
        "status",
        "start_date"
      ]
    },
    "auditScans": {
      "table": "audit_scans",
      "requiredColumns": [
        "scan_id",
        "audit_id",
        "asset_tag",
        "scanned_at",
        "is_discrepancy"
      ]
    }
  },
  "enumTargets": [
    {
      "enum": "transferOrderStatus",
      "files": [
        "backend/packages/services/ham-service/src/transfer/transfer-repository.ts",
        "frontend/src/services/ham-api.ts"
      ]
    },
    {
      "enum": "transferPriority",
      "files": [
        "backend/packages/services/ham-service/src/transfer/transfer-repository.ts",
        "frontend/src/services/ham-api.ts"
      ]
    },
    {
      "enum": "transferLineStatus",
      "files": [
        "backend/packages/services/ham-service/src/transfer/transfer-repository.ts"
      ]
    }
  ],
  "fileChecks": [
    {
      "path": "backend/packages/services/ham-service/src/transfer/transfer-service.ts",
      "tokens": [
        "VALID_STATUS_TRANSITIONS",
        "createTransfer(",
        "approveTransfer(",
        "completeTransfer("
      ]
    },
    {
      "path": "backend/packages/services/ham-service/src/transfer/transfer-repository.ts",
      "tokens": [
        "FROM transfer_orders",
        "FROM transfer_order_lines"
      ]
    },
    {
      "path": "frontend/src/services/ham-api.ts",
      "tokens": [
        "/ham/transfers",
        "/ham/loaners",
        "/ham/disposal",
        "/ham/audits/discrepancies"
      ]
    }
  ],
  "requiredRuntimeRoutes": [
    {
      "path": "/ham/transfers",
      "methods": [
        "GET",
        "POST"
      ]
    },
    {
      "path": "/ham/transfers/{transferId}/approve",
      "methods": [
        "POST"
      ]
    },
    {
      "path": "/ham/transfers/{transferId}/complete",
      "methods": [
        "POST"
      ]
    },
    {
      "path": "/ham/loaners",
      "methods": [
        "GET"
      ]
    },
    {
      "path": "/ham/disposal",
      "methods": [
        "GET",
        "POST"
      ]
    },
    {
      "path": "/ham/audits/discrepancies",
      "methods": [
        "GET"
      ]
    },
    {
      "path": "/ham/stockrooms/{stockroomId}/inventory",
      "methods": [
        "GET",
        "PUT"
      ]
    }
  ],
  "requiredOpenApiRoutes": []
}

